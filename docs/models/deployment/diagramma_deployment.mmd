%%{init: {"theme": "default", "fontFamily": "Arial, Liberation Sans, sans-serif", "flowchart": {"defaultRenderer": "elk", "htmlLabels": true}, "elk": {"mergeEdges": false}}}%%
flowchart-elk TB
  DPO(["DPO / Resp. Sicurezza / Autorità"])

  subgraph PH["Confine del Sistema Pharos"]
    direction TB

    subgraph ND["«device» Dispositivo Utente (:UserDevice) — Browser / Vue.js PWA (CDN HTTPS)"]
      AU["Applicazione Web Utente (PWA)<br/>UI WCAG 2.1 AA, Panic Button, Diario cifrato offline (IndexedDB)<br/>Servizi Territoriali offline, Counseling, De-identificazione (WASM), E2EE (Web Crypto)"]
    end

    subgraph NC["«device» Postazione CDF (:CDFWorkstation) — Desktop Browser / Vue.js (CDN HTTPS)"]
      AC["Applicazione Web CDF<br/>Gestione Pratiche, Periodi di Assenza, Report CUG<br/>Decifratura E2EE client-side (Web Crypto)"]
    end

    subgraph NS["«cloud managed» Server Applicativo (:ApplicationServer) — Server Cloud UE (API Gateway, Auth, Servizi applicativi, Realtime)"]
      CA["Controllo Accessi e Sicurezza<br/>(Ingresso unico, SSO/RBAC, verifica E2E, log/telemetria)"]
      GU["Gestione Utente (MO_GU)"]
      GC["Gestione CDF (MO_GCDF)"]
      TG["Triage Guidato"]
      RC["Reportistica CUG"]
      GN["Gestione Notifiche"]
    end

    subgraph NI["«serverless container» Nodo Modulo IA (:AIInferenceNode) — Container Serverless UE (Stateless)"]
      IA["Modulo IA di Triage<br/>(stateless, Zero-Retention)"]
      AD["Adattatore Provider IA<br/>(Interfaccia standard)"]
    end

    subgraph NP["«cloud managed database» Server di Persistenza (:PersistenceServer) — Server Cloud UE (Managed Database + Object Storage cifrato)"]
      PD[("Persistenza Dati<br/>Anagrafica | Contenuti cifrati E2EE e Diario<br/>Metadati statistici | Servizi Territoriali")]
    end

    subgraph NAB["«cloud WORM storage» Storage Audit e Backup (:AuditBackupStorage) — Object Storage WORM UE (Compliance, IAM isolato)"]
      AL[("Audit Log Immodificabile<br/>(WORM append-only, soli metadati CDF)")]
      BK[("Archivio Backup Cifrati<br/>(giornalieri off-site)")]
    end
  end

  subgraph EXT["Sistemi esterni"]
    IDP["«external» Provider di Identità di Ateneo (:UniversityIdP)<br/>SAML 2.0 / OIDC (MVP: IdP Cloud + MFA)"]
    HSM["«external» HSM/KMS istituzionale (:HSM_KMS)<br/>MVP: Cloud KMS UE · Prod: HSM Ateneo"]
    SN["«external» Servizio di Notifiche (:NotificationService)<br/>Gateway e-mail UE + Web Push (VAPID)"]
    PIA["«external, optional» Provider IA esterno (:ExternalAIProvider)<br/>Endpoint LLM gestito SEE (DPA Zero-Retention)"]
  end

  %% Comunicazioni interne a Pharos (frecce continue)
  AU -->|"HTTPS (TLS 1.3) [F1–F3]"| CA
  AC -->|"HTTPS (TLS 1.3) [F1, F3, F4]"| CA
  CA --> GU & GC & TG & RC
  GU -->|"[F3]"| GN
  GC -->|"[F3]"| GN
  GU -->|"TLS [F2–F3]: Diario cifrato, Segnalazioni, Servizi"| PD
  GC -->|"TLS [F3]: Pratiche, Periodi di Assenza"| PD
  RC -->|"TLS [F4]: soli metadati"| PD
  GN -->|"TLS [F3]: soli dati di contatto"| PD
  GC -->|"HTTPS/API WORM [F3]: append-only"| AL
  PD -->|"TLS: replica backup giornalieri cifrati"| BK
  TG -->|"HTTPS (TLS 1.3) [F2]: testo depurato"| IA
  IA --> AD

  %% Interazioni con sistemi esterni e controllo indipendente (frecce tratteggiate)
  AU -.->|"SAML 2.0/OIDC [F1]: SSO"| IDP
  AC -.->|"SAML 2.0/OIDC [F1]: SSO + MFA"| IDP
  CA -.->|"HTTPS (TLS 1.3) [F1]: verifica ruoli RBAC"| IDP
  AC -.->|"HTTPS (TLS 1.3) [F3]: decifratura E2EE"| HSM
  GN -.->|"HTTPS / SMTPS (TLS 1.3) [F3]: avvisi no dati sensibili"| SN
  AD -.->|"HTTPS (TLS 1.3) [F2]: Zero-Retention"| PIA
  DPO -.->|"HTTPS (TLS 1.3): sola lettura tracciata (canale separato)"| AL

  classDef ext fill:#EFEFEF,stroke:#1E2A4A
  class IDP,HSM,SN,PIA ext
  style PH fill:#F7F5FC,stroke:#1E2A4A
  style ND fill:#E8E4F5,stroke:#1E2A4A
  style NC fill:#E8E4F5,stroke:#1E2A4A
  style NS fill:#DCE6F5,stroke:#1E2A4A
  style NI fill:#FDEFD9,stroke:#1E2A4A
  style NP fill:#E3F1E6,stroke:#1E2A4A
  style NAB fill:#E3F1E6,stroke:#1E2A4A
  style EXT fill:#EFEFEF,stroke:#1E2A4A
  linkStyle default stroke:#1E2A4A,stroke-width:1.5px