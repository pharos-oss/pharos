@startuml NavigationalPath_CDF
title Navigational Path: CDF
hide empty description

skinparam DefaultFontName Arial
skinparam nodesep 50
skinparam ranksep 60

skinparam StateStartColor Black
skinparam StateEndColor Black

skinparam state {
    BackgroundColor #FFF2CC
    BorderColor #D6B656
}

state "MU_07: Dashboard Segnalazioni\n(Punto di Ingresso)" as Dashboard #D5E8D4

state "MU_10: Report Statistici" as MU10
state "MU_08: Dettaglio Pratica\n(Rif. SD_02)" as MU08
state "MU_09: Richiesta Integrazione" as MU09

state "Torna alla Dashboard" as R1 #D5E8D4
state "Torna alla Dashboard" as R2 #D5E8D4

[*] --> Dashboard

' --- FLUSSO REPORTISTICA ---
Dashboard --> MU10 : Seleziona menu "Report"
MU10 --> MU10 : Click "Stampa" / "Esporta Report" / "Esporta CSV"
MU10 --> R1 : Navigazione menu laterale

' --- FLUSSO GESTIONE SINGOLA PRATICA ---
Dashboard --> MU08 : Click "Prendi in carico" / "Apri pratica"
MU08 --> MU08 : Click "Prendi in carico" / "Esporta PDF"
MU08 --> R2 : Breadcrumbs "Dashboard > Pratiche"

' --- RICHIESTA INTEGRAZIONI (Sotto-flusso) ---
MU08 --> MU09 : Click "Richiedi integrazione"
MU09 --> MU08 : Click "Invia richiesta"
MU09 --> MU08 : Click "Torna alla pratica" [Annulla]

@enduml