@startuml
|Utente|
start
:annota dinamiche e prove\nsul diario delle evidenze;
:si consulta con il modulo AI per valutare la gravità,\nclassificare la violenza e ricevere supporto sull'iter;
if (vuole inviare la segnalazione al Consigliere?) then (no)
  :l'evento rimane salvato nel diario;
  :reindirizzamento alla Home;
  stop
else (si)
  :compila il modulo standardizzato di segnalazione;
  |Consigliere di fiducia|
  :presa in carico ed esame della segnalazione\nnell'area riservata;
  :analisi dei dati e generazione dei report statistici;
  |Utente|
  if (vuole continuare con l'iter burocratico?) then (no)
    :la segnalazione rimane archiviata;
    stop
  else (si)
    |Consigliere di fiducia|
    :si accorda privatamente con l'utente\nper la gestione dell'iter;
    stop
  endif
endif
@enduml