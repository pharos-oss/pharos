@startuml SD_01_InvioSegnalazioneTriage
skinparam shadowing false
skinparam defaultFontName "DejaVu Sans"
skinparam defaultFontSize 11
skinparam roundcorner 10
skinparam BoxPadding 10

skinparam sequence {
    ArrowColor #4A4A5A
    LifeLineBorderColor #1E2A4A
    LifeLineBackgroundColor #E8E4F5
    ParticipantBorderColor #1E2A4A
    ParticipantBackgroundColor White
    ParticipantFontColor #1E2A4A
    BoxBackgroundColor #F8F9FA
    BoxBorderColor #D0D0D0
}

autonumber

actor "Utente\n(Marco)" as U
boundary "InterfacciaUtente" as IU
control "GestoreSegnalazione" as GS
entity "ValutazioneIA" as VIA
entity "ServizioTerritoriale" as ST
entity "Segnalazione" as S
entity "Notifica" as N

== Fase 1: Compilazione Modulo Triage Guidato Opzionale tramite Modulo IA (RF_GU_05, RF_GU_10) ==

U -> IU : Compila testo e seleziona eventi/allegati
activate IU

|||

opt L'utente richiede lo screening orientativo (RNF_U_01)
    U -> IU : Avvia Triage Guidato
    
    |||
    
    IU -> GS : avviaTriageGuidato(testoSegnalazione)
    activate GS
    
    ' Garantisce l'anonimizzazione preventiva e la policy zero-retention (RNF_L_01, RNF_IM_02)
    GS -> GS : anonimizzaTesto(testoSegnalazione)
    
    |||
    
    ' Interrogazione stateless con vincolo temporale <= 5s (RNF_P_01)
    GS -> VIA : impostaRisultato(testoAnonimo)
    activate VIA
    VIA --> GS : Valutazione generata (gravità, tipologia)
    deactivate VIA
    
    ||20||
    
    ' Recupero dei servizi territoriali consigliati in base all'esito (RF_GU_11)
    GS -> ST : ottieniContatti(tipologiaViolenza)
    activate ST
    ST --> GS : Lista strutture e centri antiviolenza
    deactivate ST
    
    ||20||
    
    GS --> IU : Restituisce esito Triage guidato e contatti utili
    deactivate GS
    
    |||
    
    IU --> U : Mostra avviso "Esito Orientativo" + suggerimenti
end

||20||

== Fase 2: Scelta dell'Utente (Conferma vs Interruzione) ==

alt Scenario A: L'utente conferma l'invio formale al CDF (RF_GU_05)

    U -> IU : Conferma invio segnalazione
    
    |||
    
    IU -> GS : inviaSegnalazione(datiSegnalazione, allegati)
    activate GS
    
    ' Creazione entità Segnalazione
    GS -> S : create(dati, stato="Inviata")
    activate S
    S --> GS : Segnalazione creata con successo
    deactivate S
    
    ||20||
    
    ' Creazione e notifica al CDF (RF_GU_07)
    GS -> N : create(tipo="Stato", messaggio="Nuova segnalazione inviata")
    activate N
    N --> GS : Notifica registrata
    deactivate N
    
    ||20||
    
    GS --> IU : Conferma operazione
    deactivate GS
    
    |||
    
    IU --> U : Mostra messaggio "Segnalazione inoltrata con successo al CDF"

else Scenario B: L'utente decide di annullare o interrompere l'iter (RF_GU_09)

    |||

    U -> IU : Clicca su "Annulla / Interrompi Iter"
    IU -> GS : interrompiIter()
    activate GS
    
    |||
    
    GS -> GS : Scarta dati temporanei non inviati
    GS --> IU : Conferma annullamento
    deactivate GS
    
    |||
    
    IU --> U : Chiude il form e mostra "Procedura annullata, nessun dato salvato"

    deactivate IU

end

@enduml